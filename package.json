{
  "name": "photo-geotagger",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform photo geotagger for Sony A6400 files \u2014 a GeoSetter replacement for PC and Android",
  "type": "module",
  "workspaces": [
    "packages/*",
    "spike"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "spike": "npm run spike --workspace spike",
    "dev": "npm run dev --workspace @geotagger/ui",
    "build": "npm run build --workspace @geotagger/ui",
    "dev:lan": "npm run dev:lan --workspace @geotagger/ui",
    "preview": "npm run preview --workspace @geotagger/ui",
    "preview:lan": "npm run preview:lan --workspace @geotagger/ui"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.0"
  }
}
