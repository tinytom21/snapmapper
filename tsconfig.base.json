{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,

    // Node resolves the on-disk specifier, so imports must carry a real `.ts`
    // extension. Permitted because nothing here is emitted.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Node strips types rather than compiling them, so nothing that requires
    // code generation is allowed.
    "erasableSyntaxOnly": true
  }
}
